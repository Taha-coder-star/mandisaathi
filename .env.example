# Copy to .env and fill in. Never commit .env. No quotes, no spaces around "=".

# System-user token (Business settings > Users > System users > Generate new token)
# Permissions: whatsapp_business_messaging, whatsapp_business_management only
WA_TOKEN=

# App > Connect on WhatsApp > Step 1. Try it out. WA_PHONE_NUMBER_ID is also the sender for all outbound calls (task 5.1).
WA_PHONE_NUMBER_ID=
WA_WABA_ID=

# Graph API version for outbound sends (task 5.1). Leave blank to use the code default (v21.0).
GRAPH_API_VERSION=

# App settings > Basic (APP_SECRET verifies X-Hub-Signature-256 on the webhook, task 2.2)
META_APP_ID=
META_APP_SECRET=

# Any long random string you choose; paste the same value in App > WhatsApp > Configuration > Verify token (task 2.2)
WA_VERIFY_TOKEN=

# Postgres (task 2.1). Long random value: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Key for hashing phone numbers before storage (task 3.1, file 07 §3). python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never change it once used: stored hashes would stop matching. Webhook returns 503 while it is empty.
PHONE_HASH_KEY=

# Key for encrypting the sending phone number (task 5.1, file 07 §3). python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it once used: stored ciphertext would stop opening and replies could not be sent. Webhook returns 503 while it is empty.
WA_NUMBER_ENC_KEY=

# Public hostname for Caddy HTTPS: Elastic IP with dashes + .sslip.io, e.g. 13-201-5-7.sslip.io (localhost for local dev)
SITE_HOST=localhost
