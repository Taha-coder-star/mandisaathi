# Copy to .env and fill in. Never commit .env. No quotes, no spaces around "=".

# System-user token (Business settings > Users > System users > Generate new token)
# Permissions: whatsapp_business_messaging, whatsapp_business_management only
WA_TOKEN=

# App > Connect on WhatsApp > Step 1. Try it out
WA_PHONE_NUMBER_ID=
WA_WABA_ID=

# App settings > Basic (APP_SECRET verifies X-Hub-Signature-256 on the webhook, task 2.2)
META_APP_ID=
META_APP_SECRET=

# Postgres (task 2.1). Long random value: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Public hostname for Caddy HTTPS: Elastic IP with dashes + .sslip.io, e.g. 13-201-5-7.sslip.io (localhost for local dev)
SITE_HOST=localhost
